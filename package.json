{
  "name": "shugg-dev-site-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:unit": "node tests/support/run-with-budget.js 60 -- node --test tests/unit/*.test.js",
    "test:worker": "node tests/support/run-with-budget.js 60 -- node --test tests/integration/sudoku-worker.test.js",
    "test:e2e": "node tests/support/run-playwright-projects.js",
    "test:e2e:baseurl": "node tests/support/run-playwright-projects.js",
    "test": "npm run test:unit && npm run test:worker && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
